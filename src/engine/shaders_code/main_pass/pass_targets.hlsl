#ifndef MAIN_PASS_TARGETS_HLSL
#define MAIN_PASS_TARGETS_HLSL

// Раскладка color-выходов MAIN_PASS — один источник истины на весь проход.
//
// Число выходов фрагментника обязано совпадать с числом color-таргетов прохода
// (SetDefaultMainRenderPass): attachment, которому не соответствует выход шейдера, получает
// НЕОПРЕДЕЛЁННОЕ содержимое — а таргет 2 читает композит AO-прохода, то есть мусор попадёт в кадр.
// Материалы получают раскладку вместе с базой (main_pass.frag.hlsl); шейдеры со своим main()
// (скайбокс, фракталы) включают этот файл сами — тогда добавление четвёртого таргета не потребует
// искать их по репозиторию.
//
//   0 — линейный HDR-цвет сцены
//   1 — эмиссия (источник bloom)
//   2 — доля цвета, которую гасит экранный AO: подъём от ambient-пола над прямым светом плюс
//       отражение окружения. Композит вычитает `ambient * (1 - AO)`, поэтому ноль здесь = «этот
//       шейдер экранным AO не затеняется» (так делают небо и фракталы: у них своё затенение).
#define MAIN_PASS_TARGETS                       \
    float4 color    : SV_Target0;               \
    float4 emission : SV_Target1;               \
    float4 ambient  : SV_Target2;

#endif
