// SSAO по одной только глубине: ни G-буфера, ни нормалей в проходе нет — нормаль восстанавливается
// из depth четырьмя тапами. Работает на ПОЛОВИННОМ разрешении (свой таргет __ssao), результат
// сглаживает билатеральный блюр, применяет ao_composite.
//
// Оценщик: тапы берутся ПО ЭКРАНУ в диске вокруг пикселя, у каждого восстанавливается настоящая
// view-позиция Q, и вклад — СИНУС подъёма Q над КАСАТЕЛЬНОЙ ПЛОСКОСТЬЮ точки, то есть
// saturate((Q-P)·N / |Q-P|), помноженный на затухание по мировому радиусу. Вклад тапа лежит
// в [0,1], среднее по тапам — тоже, поэтому Intensity линейно управляет ГЛУБИНОЙ тени.
//
// Деления на |Q-P|² (Alchemy AO, McGuire et al.) здесь нет намеренно: у той величины нет верхней
// границы — ближний тап даёт ~1/|Q-P|, в углу сумма 16 тапов уходит далеко за единицу, saturate
// срезает её в ноль, и AO становится ДВОИЧНЫМ: либо чёрное, либо ничего. Intensity в таком виде
// двигает только границу заливки, а Power не двигает ничего — pow(0, k) = 0.
//
// Почему не «поставить точку в полусфере и сравнить глубины», как делает учебный SSAO: у того
// оценщика порог самозатенения абсолютный, а на поверхности, повёрнутой к камере ребром, глубина
// между соседними пикселями меняется на порядок сильнее этого порога — и вся поверхность
// засчитывает себя закрытой. На практике это выглядит как «повернул камеру к горизонту, и пол
// залило затенением». Здесь такого класса ошибки нет по построению: наклон плоскости входит в N,
// а bias — доля глубины, а не абсолют.
//
// Мир глазами шейдера — view-пространство камеры: там AO и считается (радиус в мировых единицах
// одинаков во всех направлениях, чего экранный радиус не даёт). Обратное преобразование
// depth → view — в comp/view_from_depth.hlsli, общем с туманом.

[[vk::combinedImageSampler]]
Texture2D<float>  u_depth   : register(t0, space0);
[[vk::combinedImageSampler]]
SamplerState      u_depthS  : register(s0, space0);

// [[vk::image_format]]: DXC не выводит формат storage-образа из float (молча даёт rgba32f) —
// обязан совпадать с текстурой (r32f, см. TexturePresets::AmbientOcclusion), иначе UB.
struct CameraData { float4x4 view; float4x4 proj; };
StructuredBuffer<CameraData> Camera : register(t1, space0);   // ro-буфер идёт ПОСЛЕ сэмплеров

[[vk::image_format("r32f")]]
RWTexture2D<float> u_ao : register(u0, space1);

cbuffer AOParams : register(b0, space2) {
    float radius;      // радиус полусферы в МИРОВЫХ единицах
    float intensity;   // сила затенения; 0 = AO выключен (пишем единицы)
    float power;       // контраст кривой (>1 — темнее в углах, светлее на открытом)
    float bias;        // сдвиг против самозатенения, в единицах view-глубины
};

// Тапов на пиксель. Шум оценщика падает как 1/sqrt(N) — вдвое больше тапов = на треть тише.
// С поворотом ядра по тайлу 4x4 и бокс-блюром 4x4 эффективный набор ещё в 16 раз шире.
static const uint SAMPLE_COUNT = 32;

#include "comp/view_from_depth.hlsli"   // ViewZ/ViewPos — требуют объявленным Camera (выше)

// Ядро вращается и сдвигается по радиусу ТАЙЛОМ 4x4 — свой вариант на каждый из 16 пикселей.
// Не шумовая функция: рисунок обязан быть ТОЧНО периодичным с периодом 4, потому что гасит его
// бокс-блюр 4x4 (ssao_blur.hlsli), усредняющий все 16 вариантов в равных долях. Псевдослучайный
// поворот (interleaved gradient noise) такому сокращению не поддаётся — остаток от него и виден
// как регулярные полосы, которые не убирает ни одна настройка.
uint TileIndex(uint2 pix)
{
    const uint2 t = pix & 3u;
    return t.y * 4u + t.x;
}

[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    uint w, h; u_ao.GetDimensions(w, h);
    if (tid.x >= w || tid.y >= h) return;

    // Глубина — ПОЛНОГО разрешения, карта AO — половинного. Центр половинного текселя лежит
    // ровно НА ГРАНИЦЕ двух текселей глубины ((x+0.5)/w*2w = 2x+1), а какой из двух возьмёт
    // NEAREST на точной границе — не определено: выбор «плавает» по столбцам и строкам, и это
    // видно как регулярные полосы. Поэтому адресуем ЯВНО центр верхне-левого текселя блока 2x2.
    uint dw, dh; u_depth.GetDimensions(dw, dh);
    const float2 dtexel = 1.0 / float2(dw, dh);
    const float2 uv = (float2(tid.xy) * 2.0 + 0.5) * dtexel;
    const float  d  = u_depth.SampleLevel(u_depthS, uv, 0);

    // Дальняя плоскость = ничего не нарисовано (клир прохода). Небо не затеняется — и заодно
    // ViewZ там уходит в бесконечность, а реконструкция нормали по соседям теряет смысл.
    if (d >= 1.0 || intensity <= 0.0) { u_ao[tid.xy] = 1.0; return; }

    const float3 P = ViewPos(uv, d);

    // Нормаль из глубины: по паре соседей на ось берём ТУ, что ближе по z. На силуэте один из
    // соседей лежит на другой поверхности — взяв его, нормаль «размажется» через край и AO
    // потечёт с фона на объект; выбор ближнего оставляет обе стороны силуэта своими.
    //
    // База стенсила — ОДИН тексель, и расширять её нельзя, хотя шум нормали от этого и падает
    // (ошибка наклона = dz/база): широкая база усредняет наклон по площади и сносит ровно тот
    // мелкий рельеф, ради которого AO и считается — стыки, фаски, контакты. Шум тут снимается
    // числом тапов, а не сглаживанием входа.
    const float2 uvL = uv - float2(dtexel.x, 0);
    const float2 uvR = uv + float2(dtexel.x, 0);
    const float2 uvD = uv - float2(0, dtexel.y);
    const float2 uvU = uv + float2(0, dtexel.y);
    const float3 pL = ViewPos(uvL, u_depth.SampleLevel(u_depthS, uvL, 0));
    const float3 pR = ViewPos(uvR, u_depth.SampleLevel(u_depthS, uvR, 0));
    const float3 pD = ViewPos(uvD, u_depth.SampleLevel(u_depthS, uvD, 0));
    const float3 pU = ViewPos(uvU, u_depth.SampleLevel(u_depthS, uvU, 0));

    const float3 dx = (abs(pR.z - P.z) < abs(P.z - pL.z)) ? (pR - P) : (P - pL);
    const float3 dy = (abs(pU.z - P.z) < abs(P.z - pD.z)) ? (pU - P) : (P - pD);

    float3 N = cross(dx, dy);
    const float nlen = length(N);
    if (nlen < 1e-8) { u_ao[tid.xy] = 1.0; return; }
    N /= nlen;
    // Разворачиваем нормаль К КАМЕРЕ по знаку dot(N, P), а не по знаку N.z: P — вектор от камеры
    // в точку, и у видимой поверхности нормаль ему противонаправлена всегда, тогда как N.z > 0
    // верно лишь около центра кадра и врёт на краях широкого FOV.
    if (dot(N, P) > 0.0) N = -N;

    // Поворот и радиальный сдвиг — из одного тайла, но по РАЗНЫМ отображениям: взять для обоих
    // t/16 значило бы жёстко связать угол с радиусом, и 16 вариантов легли бы одной спиралью.
    // frac(t·φ) раскладывает 16 сдвигов равномерно и с поворотом не коррелирует.
    const uint  tile = TileIndex(tid.xy);
    const float rot  = (float(tile) + 0.5) * (6.2831853 / 16.0);
    const float rjit = frac(float(tile) * 0.6180339887);
    const float viewDepthP = -P.z;

    // Мировой радиус → радиус диска в UV кадра: r_ndc = radius·proj / z, а uv = ndc/2. Потолок
    // нужен вблизи: у поверхности под носом радиус улетает на весь экран, и тапы уходят на
    // геометрию, никак с точкой не связанную.
    const float2 radiusUV = min(0.5 * radius * float2(Camera[0].proj[0][0], Camera[0].proj[1][1]) / max(viewDepthP, 1e-4), 0.1);

    // Порог самозатенения — ДОЛЯ глубины: шум восстановленной нормали и квантование буфера растут
    // с дистанцией ровно так же, абсолютный порог пришлось бы перекручивать под каждый ракурс.
    const float beta = bias * viewDepthP;
    const float eps  = 1e-4;

    // Пол радиуса тапа, в ТЕКСЕЛЯХ глубины: тап ближе текселя читает ТОТ ЖЕ тексель, что и P, —
    // это не близкий сосед, а та же самая точка, и |Q-P| у неё состоит из одного квантования,
    // которое делитель |Q-P| в оценщике ещё и усиливает.
    //
    // Ровно один, не два. Пол растягивает короткие смещения наружу, а вытолкнутый тап легко
    // выходит за МИРОВОЙ радиус, где его гасит falloff — то есть пол не только чистит шум, но и
    // отнимает затенение. При двух текселях он доставал до середины диска на средних дистанциях
    // и заметно ослаблял эффект; при одном трогает лишь то, что и так вырождено.
    const float MIN_TAP_TEXELS = 1.0;

    // Затухание по мировому радиусу считаем сами: 1/|v|² убрано, а вместе с ним и его роль
    // range-check'а. Уходящая вдаль поверхность попадает в экранный диск целиком, но к полусфере
    // точки отношения не имеет — без этого множителя фон затенял бы передний план.
    //
    // Форма — ОКНО, а не рампа: внутри радиуса сосед загораживает в полную силу, гаснет он только
    // у самой границы. Линейная рампа 1-|v|²/r² в среднем по диску даёт 0.5, то есть делит всё AO
    // пополам — во впадине это незаметно (там закрыто со всех сторон, и хватает остатка), а
    // одиночный прямой угол, где закрыта ровно половина полусферы, из-за неё еле виден.
    const float inv_r2 = 1.0 / max(radius * radius, 1e-8);
    const float FADE_START = 0.64;   // = (0.8·radius)², дальше окно плавно садится в ноль

    float occlusion = 0.0;
    [loop]
    for (uint i = 0; i < SAMPLE_COUNT; ++i)
    {
        // Диск Фогеля: sqrt по номеру даёт равномерную плотность ПО ПЛОЩАДИ, золотой угол —
        // отсутствие спиц. Смещение rjit внутри кольца — своё на пиксель тайла: без него все 16
        // пикселей тайла берут тапы на ОДНИХ И ТЕХ ЖЕ радиусах, различаясь лишь углом, и блюр
        // усредняет 16 направлений на тап, но по-прежнему SAMPLE_COUNT колец. Радиальная
        // недосэмплировка и есть вторая половина «шума»; со сдвигом тайл покрывает их в 16 раз
        // больше, период 4 сохраняется.
        const float rr  = sqrt((float(i) + rjit) / float(SAMPLE_COUNT));
        const float phi = rot + float(i) * 2.3999632;

        float2 off = float2(cos(phi), sin(phi)) * rr * radiusUV;
        // Растягиваем только слишком короткие смещения — направление сохраняется, диск не мнётся.
        const float len_texels = length(off / dtexel);
        if (len_texels < MIN_TAP_TEXELS) off *= MIN_TAP_TEXELS / max(len_texels, 1e-6);

        const float2 suv = uv + off;
        if (any(suv < 0.0) || any(suv > 1.0)) continue;

        const float sd = u_depth.SampleLevel(u_depthS, suv, 0);
        if (sd >= 1.0) continue;   // за тапом небо — не загораживает

        const float3 Q = ViewPos(suv, sd);   // что РЕАЛЬНО нарисовано в этом месте экрана
        const float3 v = Q - P;
        const float  vv = dot(v, v);
        if (vv < eps) continue;              // тап лёг в тот же тексель: направления нет
        const float  vn = dot(v, N);

        // Синус подъёма над касательной плоскостью = доля полусферы, закрытая с этого
        // направления.
        const float inv_len = rsqrt(vv);
        const float s_raw   = saturate(vn * inv_len);

        // Порог самозатенения тоже переводим в синус — и РАСТЯГИВАЕМ остаток обратно на [0,1].
        // Без растяжения порог вычитается из всех направлений подряд, включая те, что закрыты
        // полностью: у стенки под прямым углом синус равен единице, и beta/|v| срезает с неё
        // заметную долю (при bias=0.01 и z=20 это 0.2 мира — половина типичного |v|). То есть
        // порог, задуманный как защита от acne на плоскости, тихо гасил настоящие углы, причём
        // тем сильнее, чем дальше они от камеры. С растяжением полностью закрытое направление
        // даёт 1 при любом пороге, а режется только пологое — ради чего порог и заводился.
        const float thr      = saturate(beta * inv_len);
        const float sin_elev = saturate((s_raw - thr) / max(1.0 - thr, 1e-3));

        occlusion += sin_elev * (1.0 - smoothstep(FADE_START, 1.0, vv * inv_r2));
    }

    // Среднее по тапам ∈ [0,1]; пропущенные (небо, выход за кадр, вырожденное направление)
    // считаются открытыми. Величина безразмерная и от radius не зависит по построению, а не
    // за счёт компенсирующего множителя: Radius меняет ТОЛЬКО масштаб деталей, Intensity —
    // линейно глубину тени, Power — форму кривой между ними.
    const float ao = saturate(1.0 - intensity * occlusion / float(SAMPLE_COUNT));
    u_ao[tid.xy] = pow(ao, max(power, 1e-3));
}
