#ifndef SPARSE_RANK_HLSL
#define SPARSE_RANK_HLSL

// Примитивы РАЗРЕЖЕННОГО ПО СТРОКАМ канала: данные есть у малой доли строк домена, и держать под
// них полноразмерное поле — значит платить его ширину за значение «ничего нет». Вместо этого на
// строку остаётся один бит присутствия, а сами данные лежат КОМПАКТНО, по одному элементу на
// носителя; адрес элемента даёт rank — число носителей до этой строки.
//
// rank считается за O(1) без поиска: presence-биты режутся на слова по 32, у каждого слова
// хранится префикс-popcount (сколько носителей до него), и остаётся добавить popcount битов
// своего слова ниже позиции.
//
// Модуль даёт только хелперы; буферы объявляет вызывающий с нужными регистрами — так один и тот
// же механизм носят и текст-канал UI, и канал состояний вариантов текстур, не согласовывая слоты.

// Есть ли данные у строки (по уже загруженному слову presence-маски).
bool SparseHasBit(uint word, uint bit) { return ((word >> bit) & 1u) != 0u; }

// Компактный индекс строки = число единиц ДО неё.
uint SparseRank(uint word, uint wordBase, uint bit) {
    return wordBase + countbits(word & ((1u << bit) - 1u));
}

#endif
