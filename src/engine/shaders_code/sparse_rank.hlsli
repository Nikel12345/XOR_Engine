#ifndef SPARSE_RANK_HLSL
#define SPARSE_RANK_HLSL

// ───────────────────────── Разреженный по строкам канал ─────────────────────────
// Данные есть у малой доли строк домена, и держать под них полноразмерное поле — значит платить
// его ширину за значение «ничего нет». Вместо этого на строку остаётся один бит присутствия, а
// сами данные лежат КОМПАКТНО, по одному элементу на носителя; адрес элемента даёт rank — число
// носителей до этой строки.
//
// rank считается за O(1) без поиска: presence-биты режутся на слова по 32, у каждого слова рядом
// лежит префикс-popcount (сколько носителей до него), и остаётся добавить popcount битов своего
// слова ниже позиции. Пара {биты, префикс} — один uint2, потому что по отдельности они не бывают
// валидны; CPU-половина канала и раскладка слова — engine/include/SparseRankChannel.h.
//
// Стоимость на горячем пути: строка-НЕ-носитель отвечает ОДНОЙ загрузкой и ветвлением, а таких
// строк подавляющее большинство — вторая загрузка (уже в данные канала) достаётся только
// носителям. Полноразмерное поле стоило бы столько же загрузок, но в 16 раз больше памяти.

// Объявляет канал NAME: буфер слов NAME##Words на регистре REG и функцию NAME##Rank(row) →
// компактный индекс носителя, либо -1 если у строки данных нет (в т.ч. row < 0 — «строки нет
// вовсе», как у transformless-объектов с PIB = -1).
//
// Канал даёт ТОЛЬКО адресацию. Буфер с самими данными объявляет вызывающий — их раскладка у
// каждого канала своя, а регистры движок раздаёт порядком буферов в списке sp.
#define SPARSE_CHANNEL(NAME, REG, SPACE)                                    \
    StructuredBuffer<uint2> NAME##Words : register(REG, SPACE);             \
    int NAME##Rank(int row)                                                 \
    {                                                                       \
        if (row < 0) return -1;                                             \
        const uint  b = uint(row) & 31u;                                    \
        const uint2 w = NAME##Words[uint(row) >> 5u];                       \
        if (((w.x >> b) & 1u) == 0u) return -1;                             \
        return int(w.y + countbits(w.x & ((1u << b) - 1u)));                \
    }

#endif
